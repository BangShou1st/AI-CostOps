# ============================================================
# AI CostOps — Local Development Example
# 仅用于本地开发示例，不是生产配置。
# 真实 .env 必须保持在 Git Ignore 中。
# ============================================================

MYSQL_DATABASE=aicostops
MYSQL_USER=aicostops
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-local-root-only
MYSQL_PORT=3307

FRONTEND_PORT=8080
BACKEND_PORT=8081

REDIS_PORT=6379
REDIS_PASSWORD=change-me-local-only

MINIO_ROOT_USER=aicostops
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=aicostops-evidence
AICOSTOPS_STORAGE_UPLOAD_LIMIT=512MB
AICOSTOPS_MULTIPART_MAX_FILE_SIZE=520MB
AICOSTOPS_MULTIPART_MAX_REQUEST_SIZE=525MB

AICOSTOPS_JWT_SIGNING_KEY=local-development-only-signing-key-change-before-production-2026
AICOSTOPS_ALLOW_PUBLIC_REGISTRATION=true
PUBLIC_REGISTRATION_ORG_SLUG=local-dev
AICOSTOPS_ALLOWED_ORIGINS=http://localhost:8080
AICOSTOPS_REFRESH_COOKIE_SECURE=false
SPRING_PROFILES_ACTIVE=dev
