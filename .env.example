# ============================================================
# AI CostOps — Local Development Example
# 仅用于本地开发示例，不是生产配置。
# 真实 .env 必须保持在 Git Ignore 中。
# ============================================================

MYSQL_DATABASE=aicostops
MYSQL_USER=aicostops
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-local-root-only
MYSQL_PORT=3307

FRONTEND_PORT=8080
BACKEND_PORT=8080

REDIS_PORT=6379
REDIS_PASSWORD=change-me-local-only

MINIO_ROOT_USER=aicostops
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=aicostops-evidence
AICOSTOPS_STORAGE_UPLOAD_LIMIT=512MB
AICOSTOPS_MULTIPART_MAX_FILE_SIZE=520MB
AICOSTOPS_MULTIPART_MAX_REQUEST_SIZE=525MB

AICOSTOPS_JWT_SIGNING_KEY=local-development-only-signing-key-change-before-production-2026
AICOSTOPS_ALLOW_PUBLIC_REGISTRATION=true
PUBLIC_REGISTRATION_ORG_SLUG=local-dev
AICOSTOPS_ALLOWED_ORIGINS=http://localhost:5173
AICOSTOPS_REFRESH_COOKIE_SECURE=false
AICOSTOPS_DEV_BOOTSTRAP_ENABLED=true
AICOSTOPS_DEV_BOOTSTRAP_EMAIL=admin@example.test
AICOSTOPS_DEV_BOOTSTRAP_DISPLAY_NAME=AI CostOps Local Admin
AICOSTOPS_DEV_BOOTSTRAP_PASSWORD=change-me-local-only
SPRING_PROFILES_ACTIVE=dev

# ============================================================
# Production environment template (M9 / v1.1)
# 生产部署禁止使用上述本地默认值；下列变量必须显式提供，且不能提交真实值。
# 完整约束与 TLS 边界见 docs/02-development/operations/01-production-configuration.md
# ============================================================
# SPRING_PROFILES_ACTIVE=prod
# AICOSTOPS_JWT_SIGNING_KEY=            # >=32 字符强随机值，必填
# SPRING_DATASOURCE_PASSWORD=           # 必填，禁止 change-me-local-only
# AICOSTOPS_REDIS_PASSWORD=             # 生产按策略要求
# AICOSTOPS_STORAGE_ENDPOINT=           # HTTPS 非 loopback，必填
# AICOSTOPS_STORAGE_ACCESS_KEY=         # 必填
# AICOSTOPS_STORAGE_SECRET_KEY=         # 必填
# AICOSTOPS_STORAGE_BUCKET=             # 必填
# AICOSTOPS_ALLOWED_ORIGINS=            # 显式非 loopback 来源，必填
# AICOSTOPS_ALLOW_PUBLIC_REGISTRATION=false
# AICOSTOPS_REFRESH_COOKIE_SECURE=true
# AICOSTOPS_DEV_BOOTSTRAP_ENABLED=false
